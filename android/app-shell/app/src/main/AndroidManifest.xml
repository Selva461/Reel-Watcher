<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- only while a job you started runs after you leave the app: its notification (Stop button) and CPU time -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- only so the optional nightly online check (off by default) stays scheduled after the phone restarts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- lets the app start Reel Shelf inside Termux (Termux asks you to allow it) -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <queries>
        <package android:name="com.termux" />
        <!-- Google Lens lives in the Google app -->
        <package android:name="com.google.android.googlequicksearchbox" />
    </queries>
    <application
        android:label="Reel Shelf"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:largeHeap="true">
        <!-- the on-phone AI model can use the GPU when the phone has these (optional) -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Instagram's own "Download your information" page inside the app, to bring the saved-reels export back -->
        <activity
            android:name=".InstagramActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />
        <!-- "Share" from Instagram (a reel) or from Meta AI (its answer): saves it and closes at once -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="Reel Shelf"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- the optional nightly online check of watchlist titles: Wi-Fi + charging + phone idle, off by default -->
        <service
            android:name=".NightlyCheck"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".WorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
